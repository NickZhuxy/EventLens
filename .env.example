# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
EVENTLENS_SERVICE_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN
# The server selects the model. API clients cannot override it.
# DeepSeek Flash with low reasoning effort. API access requires a provider key.
EVENTLENS_MODEL=deepseek-flash
EVENTLENS_API_KEY=
EVENTLENS_BASE_URL=https://api.deepseek.com
EVENTLENS_REASONING_EFFORT=low
EVENTLENS_PORT=8000
EVENTLENS_MAX_PENDING_JOBS=50
